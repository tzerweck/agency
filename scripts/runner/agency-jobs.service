# systemd user service: run queued Agency jobs once.
# Install: copy both files to ~/.config/systemd/user/, set WorkingDirectory and AGENCY_AGENT_CMD below,
# then `systemctl --user daemon-reload && systemctl --user enable --now agency-jobs.timer`.
[Unit]
Description=Agency: execute queued card jobs with a headless coding agent

[Service]
Type=oneshot
Environment="AGENCY_AGENT_CMD=claude -p --permission-mode bypassPermissions"
Environment=RADAR_URL=http://localhost:3100
WorkingDirectory=%h/agency
ExecStart=/usr/bin/env node scripts/run-jobs.mjs --once
TimeoutStartSec=6h
